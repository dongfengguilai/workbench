# 平台配置样例；不是自动读取的可运行产品。Do not commit real credentials.
EAP_VERSION=v0.1.0
EAP_COMPOSE_PROJECT=eap-v0
EAP_LISTEN_HOST=127.0.0.1
EAP_HTTP_PORT=8089
EAP_PUBLIC_ORIGIN=https://REPLACE_WITH_AUTHORIZED_HOST
EAP_DATABASE_PATH=/var/lib/eap/platform.sqlite
EAP_MAX_ACTIVE_RUNS_PER_USER=1
EAP_MAX_ACTIVE_RUNS_TOTAL=2
EAP_RUN_TIMEOUT_SECONDS=300
EAP_APPROVAL_TIMEOUT_SECONDS=120
EAP_CANCEL_CONFIRM_SECONDS=10
EAP_EVENT_RETENTION_DAYS=7
EAP_CODEX_VERSION=0.167.0
# Secrets are provisioned at deployment; no shared/default passwords.
EAP_SESSION_SECRET_FILE=/run/secrets/eap_session_secret
EAP_USER_BOOTSTRAP_FILE=/run/secrets/eap_initial_users
# Raw model/MCP enterprise master keys must NOT be put in workers.
