# ARCHITECTURE TEMPLATE ONLY. Product images and services are NOT implemented.
# One logical Code Agent, two user-isolated Runtime instances, no three-agent split.
# No runtime egress is provided here: add an approved policy-enforcing model/MCP gateway.
# Do not rename this file and claim a working or secure deployment without T7 evidence.
name: eap-v0
x-worker: &worker
  image: enterprise-agent/runtime:${EAP_VERSION:-v0.1.0}
  user: "10001:10001"
  init: true
  read_only: true
  cap_drop: [ALL]
  security_opt: [no-new-privileges:true]
  pids_limit: 256
  mem_limit: 2g
  cpus: 2
  tmpfs:
    - /tmp:rw,nosuid,size=128m
  restart: unless-stopped
services:
  eap-platform:
    image: enterprise-agent/platform:${EAP_VERSION:-v0.1.0}
    container_name: eap-platform-v0
    user: "10001:10001"
    init: true
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    ports:
      - "127.0.0.1:${EAP_HTTP_PORT:-8089}:8080"
    volumes:
      - eap-platform-data:/var/lib/eap
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=64m
    environment:
      EAP_DATABASE_PATH: /var/lib/eap/platform.sqlite
    networks:
      - eap-control-a
      - eap-control-b
    restart: unless-stopped
  eap-runtime-a:
    <<: *worker
    container_name: eap-runtime-a-v0
    environment:
      EAP_RUNTIME_ID: runtime-a
      EAP_OWNER_USER_ID: test-user-a
      EAP_POLICY_ID: scoped-user-workspace
      EAP_STATE_DIR: /var/lib/eap-runtime
    volumes:
      - eap-state-a:/var/lib/eap-runtime
    networks:
      - eap-control-a
  eap-runtime-b:
    <<: *worker
    container_name: eap-runtime-b-v0
    environment:
      EAP_RUNTIME_ID: runtime-b
      EAP_OWNER_USER_ID: test-user-b
      EAP_POLICY_ID: scoped-user-workspace
      EAP_STATE_DIR: /var/lib/eap-runtime
    volumes:
      - eap-state-b:/var/lib/eap-runtime
    networks:
      - eap-control-b
networks:
  eap-control-a:
    internal: true
  eap-control-b:
    internal: true
volumes:
  eap-platform-data:
    name: eap-v0-platform-data
  eap-state-a:
    name: eap-v0-state-a
  eap-state-b:
    name: eap-v0-state-b
